# Local development defaults. For deployment, set APP_ENV=production and use a secret manager.
APP_ENV=development
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
DATABASE_PATH=./gramsathi.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TOKEN_TTL_MINUTES=60
SEED_DEMO_DATA=true

# Optional AI integration. Keep the real key out of Git.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=20
